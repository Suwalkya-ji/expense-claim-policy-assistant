PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/expense_review

# Google Gemini for classification and policy assessment (optional).
# Get a key at https://aistudio.google.com/apikey. Without one the app falls back
# to a keyword classifier and rule-based explanations.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Requests per minute allowed by your Gemini plan. The free tier allows 5; this spaces calls to match.
# Leave unset on a paid plan. Rate-limited calls are retried either way.
GEMINI_RPM=5

# Optional shared login for a hosted demo (HTTP Basic). Leave empty locally.
APP_USERNAME=
APP_PASSWORD=

# Logs are JSON lines (one event per line). For local development, pretty is easier to read.
LOG_FORMAT=pretty
# LOG_LEVEL=info   # debug | info | warn | error | silent

# AI_DISABLED=true
